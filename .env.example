# Copy this file to .env.local on the server and fill it in.

# --- SQL Server (database created by deploy/sql-setup.sql) ---
MSSQL_SERVER=localhost
# Only for a named instance such as SQLEXPRESS (then leave MSSQL_PORT blank):
MSSQL_INSTANCE=
MSSQL_PORT=1433
MSSQL_DATABASE=TicketDesk
MSSQL_USER=ticketdesk_app
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true
# Highest TLS version used to talk to SQL Server (leave as is unless IT tells you otherwise)
MSSQL_TLS_MAX=TLSv1.2

# --- The public address users type in (must be https) ---
NEXTAUTH_URL=https://helpdesk.jmaluminium.com
# A long random string. PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])
NEXTAUTH_SECRET=

# --- Microsoft Entra app registration (used for sign-in AND sending email) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the emails are sent FROM (e.g. helpdesk@jmaluminium.com)
MS_SENDER=

# --- Access rules ---
ALLOWED_DOMAINS=jmaluminium.com,jmaluminium.in
# Comma separated. These people become admins the first time they sign in.
INITIAL_ADMIN_EMAILS=
# Where "new ticket" alerts go (comma separated). Blank = all admins.
ADMIN_ALERT_EMAILS=

# --- Folder where screenshots are stored (back this folder up with the database) ---
UPLOAD_DIR=D:\TicketDeskFiles
