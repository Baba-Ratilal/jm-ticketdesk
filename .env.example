# Copy this file to .env.local on the server and fill it in.

# --- SQL Server ---
# windows = the app signs in as the Windows account it runs under (SYSTEM). No SQL password anywhere. (recommended)
# sql     = use a SQL login instead (then fill in MSSQL_USER / MSSQL_PASSWORD and the TCP settings below)
MSSQL_AUTH=windows
MSSQL_DATABASE=TicketDesk
# Windows mode: shared memory to the SQL Server on this same machine. Leave as is for the default instance.
# For a named instance:  lpc:(local)\SQLEXPRESS
MSSQL_ODBC_SERVER=lpc:(local)
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQL mode only:
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_INSTANCE=
# MSSQL_USER=ticketdesk_app
# MSSQL_PASSWORD=
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_CERT=true
# MSSQL_TLS_MAX=TLSv1.2

# --- The address users type in. Must match EXACTLY what is in the browser's address bar ---
# e.g. http://192.168.1.20:3100 (no IIS), or https://helpdesk.jmaluminium.com (through IIS)
NEXTAUTH_URL=http://localhost:3100
# A long random string. PowerShell:  [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }) -as [byte[]])
NEXTAUTH_SECRET=

# --- Who becomes admin ---
# ERP user IDs (comma separated). They become admins the next time they sign in.
INITIAL_ADMIN_IDS=
# Where "new ticket" alerts go (comma separated emails). Blank = all admins and IT-team members who have an email.
ADMIN_ALERT_EMAILS=

# --- Email alerts through Microsoft 365 (optional; leave blank to switch email off) ---
# Used ONLY for sending mail, not for sign-in. See section 3 of SETUP-ONPREM.md.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Mailbox the emails are sent FROM (e.g. helpdesk@jmaluminium.com)
MS_SENDER=

# --- Copy of ERP users, every night at 12 AM (see section 8 of SETUP-ONPREM.md) ---
# Read-only Oracle account for the ERP database. connect string = host:port/service_name
ERP_ORA_USER=
ERP_ORA_PASSWORD=
ERP_ORA_CONNECT=
# plain = the ERP stores readable passwords: TicketDesk keeps only its own salted hash of each one
# hash  = the ERP stores a hash: TicketDesk keeps that hash and checks passwords the same way (set ERP_PW_SCHEME)
ERP_SECRET_MODE=
# md5 | sha1 | sha256 | sha512  (hex text). Needed only when ERP_SECRET_MODE=hash
ERP_PW_SCHEME=

# --- Folder where screenshots are stored (back this folder up with the database) ---
UPLOAD_DIR=D:\TicketDeskFiles
