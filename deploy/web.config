<?xml version="1.0" encoding="UTF-8"?>
<!--
  Put this file in the root folder of the NEW IIS site (e.g. C:\inetpub\ticketdesk-proxy\web.config).
  IIS forwards everything to the TicketDesk app, which listens only on this server (127.0.0.1:3100).
  Requires the IIS "URL Rewrite" and "Application Request Routing" (ARR) modules, with proxy enabled.
  If you change the port in deploy\start.cmd, change it here too.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Redirect HTTP to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" />
        </rule>
        <rule name="Forward to TicketDesk" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3100/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- allow screenshot uploads up to ~50 MB per request -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
